#!/usr/bin/env python3
from __future__ import annotations

import sys
from pathlib import Path


def _first_existing(base: Path, names: tuple[str, ...]) -> Path:
    for name in names:
        p = base / name
        if p.is_file():
            return p
    tried = ", ".join(str(base / n) for n in names)
    raise SystemExit(f"Missing config in {base} (tried: {tried})")


def main() -> None:
    if len(sys.argv) != 2:
        raise SystemExit("usage: peerProcess <peerID>")
    try:
        my_id = int(sys.argv[1])
    except ValueError:
        raise SystemExit("usage: peerProcess <peerID> (peerID must be an integer)")

    root = Path.cwd()
    sys.path.insert(0, str(Path(__file__).resolve().parent))
    from Node import load_peerinfo, run_node

    common_path = _first_existing(root, ("Common.cfg", "Common.txt"))
    peerinfo_path = _first_existing(root, ("PeerInfo.cfg", "PeerInfo.txt"))
    entries = load_peerinfo(str(peerinfo_path))
    my_entry = next((e for e in entries if e.pid == my_id), None)
    if my_entry is None:
        raise SystemExit(f"peer ID {my_id} not found in {peerinfo_path.name}")

    run_node(
        my_id=my_id,
        listen_ip=my_entry.ip,
        listen_port=my_entry.port,
        peerinfo_path=str(peerinfo_path.resolve()),
        common_path=str(common_path.resolve()),
    )


if __name__ == "__main__":
    main()
